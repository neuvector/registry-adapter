{
  "extends": [
    "github>rancher/renovate-config#release"
  ],
  "baseBranchPatterns": [
    "main"
  ],
  "prHourlyLimit": 4,
  "postUpdateOptions": [
    "gomodTidy",
    "gomodUpdateImportPaths",
    "gomodVendor"
  ],
  "ignorePaths": [
    "vendor/**/Dockerfile",
    "vendor/**/*.Dockerfile",
    "vendor/**/requirements.txt"
  ],
  "packageRules": [
    {
      "description": "Enable updates from neuvector/neuvector",
      "matchPackageNames": [
        "github.com/neuvector/neuvector"
      ], 
      "enabled": true,
      "ignoreUnstable": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/govulncheck\\.yml$/"],
      "matchStrings": [
        "GOVULNCHECK_VERSION: (?<currentDigest>[a-f0-9]+) # (?<currentValue>v[^\\s]+)"
      ],
      "depNameTemplate": "golang/vuln",
      "datasourceTemplate": "github-tags"
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "osvVulnerabilityAlerts": true
}
